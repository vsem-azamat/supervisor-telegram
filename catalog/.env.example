# Copy to .env and fill in. .env is gitignored and must stay that way —
# nothing in this file may ever hold a real token or password.
#
# One file in catalog/, read by both compose.dev.yml and the API, so the
# database credentials cannot drift apart. It is not the repository root's
# .env, which belongs to the bot and webapi.

# ── Database ────────────────────────────────────────────────────────────
# Defaults below are local development only.
POSTGRES_USER=students_cz
POSTGRES_PASSWORD=students_cz
POSTGRES_DB=students_cz
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DB_ECHO=false

# Only needed to override the URL assembled from the values above — for
# example when the API runs inside compose and reaches the database by
# service name:  postgresql+asyncpg://students_cz:students_cz@db:5432/students_cz
# DATABASE_URL=

# ── Telegram ────────────────────────────────────────────────────────────
# From @BotFather. Locally a development bot; in production the moderator
# bot's token. The API sends through it and checks initData with it, and never
# asks it for updates.
BOT_TOKEN=
# The Mini App's HTTPS origin (web/ in this repository), which the bot's
# buttons open. Its router proxies /api/v1/* here.
PUBLIC_BASE_URL=
# Optional: Telegram username the ads page offers as a contact.
ADS_CONTACT=

# Skips initData signature checking so the API can be exercised without a bot
# token. Local development only — never enable on anything reachable.
ALLOW_UNSIGNED_INIT_DATA=false

# ── The app's dev server ────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
