# Origin of the API.
#
# Leave empty in development: calls then stay same-origin and go through the
# Vite proxy to http://127.0.0.1:8010. Telegram only allows Mini App API calls
# from the app's own origin, so a cross-origin value is the exception.
VITE_API_BASE_URL=

# Raw Telegram init data to use when developing outside Telegram.
#
# Read only in development, and only by src/mockEnv.ts. Without it the mock
# generates an unsigned string, which the API correctly rejects with 401. Paste
# a real init data query string here — captured from a Mini App session signed
# by the same bot token the API runs with — to exercise authenticated calls in
# a desktop browser.
VITE_MOCK_INIT_DATA=
